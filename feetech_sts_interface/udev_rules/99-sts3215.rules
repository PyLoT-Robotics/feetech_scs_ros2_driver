# udev rule for Feetech STS3215 servo control board
# CH340 USB-to-Serial adapter (QinHeng Electronics)
# VID:PID 1a86:55d3

# Create symlink /dev/ttyUSB_sts3215 for the STS3215 board
SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666", SYMLINK+="ttyUSB_sts3215"

# Grant permission to dialout group (typically used for serial devices)
SUBSYSTEMS=="usb-serial", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d3", MODE="0666", GROUP="dialout"
